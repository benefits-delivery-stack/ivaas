#!/bin/sh
set -eu

usage() {
	echo "Usage: local-s3-object {upload|head} OBJECT_KEY" >&2
	exit 2
}

[ "$#" -eq 2 ] && [ -n "$2" ] || usage

action=$1
object_key=$2
bucket=${DPW_VMI_LOCAL_S3_BUCKET:-ivaas-dpw-vmi-inbox}
endpoint=${FAKECLOUD_ENDPOINT:-http://localhost:4566}

command -v aws >/dev/null || { echo "the aws CLI is required" >&2; exit 2; }

export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_REGION=us-east-1
export AWS_PAGER=
unset AWS_SESSION_TOKEN

case "$action" in
	head)
		exec aws --endpoint-url "$endpoint" s3api head-object \
			--bucket "$bucket" \
			--key "$object_key"
		;;
	upload)
		command -v uuidgen >/dev/null || { echo "uuidgen is required" >&2; exit 2; }

		work=$(mktemp -d "${TMPDIR:-/tmp}/local-s3-object.XXXXXX")
		trap 'rm -rf "$work"' EXIT
		trap 'exit 1' HUP INT TERM
		pdf="VMI_$(uuidgen)_$(date +%Y%m%d)_Conf-TESTCONF123.pdf"
		: >"$work/$pdf"
		tar -czf "$work/archive.tar.gz" -C "$work" "$pdf"

		aws --endpoint-url "$endpoint" s3api head-bucket --bucket "$bucket" >/dev/null 2>&1 ||
			aws --endpoint-url "$endpoint" s3api create-bucket --bucket "$bucket"
		aws --endpoint-url "$endpoint" s3api put-object \
			--bucket "$bucket" \
			--key "$object_key" \
			--body "$work/archive.tar.gz"
		;;
	*)
		usage
		;;
esac
